<Window
    x:Class="PrivateAI.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Width="820"
    Height="590"
    MinWidth="700"
    MinHeight="500"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False">

    <Border
        Margin="8"
        CornerRadius="18"
        Background="#18FFFFFF"
        BorderBrush="#45FFFFFF"
        BorderThickness="1">

        <Grid RowDefinitions="52,54,*">

            <!-- TITLE BAR -->
            <Border
                Grid.Row="0"
                Background="#18FFFFFF"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid>

                    <TextBlock
                        Text="Private AI"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                    <Button
                        Content="×"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="28"
                        Click="CloseButton_Click"/>

                </Grid>

            </Border>


            <!-- PROVIDER BUTTONS -->
            <Border
                Grid.Row="1"
                Background="#10FFFFFF"
                Padding="12,8">

                <StackPanel Orientation="Horizontal">

                    <Button
                        Content="ChatGPT"
                        Width="100"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="ChatGPT_Click"/>

                    <Button
                        Content="Claude"
                        Width="100"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="Claude_Click"/>

                    <Button
                        Content="Gemini"
                        Width="100"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="Gemini_Click"/>

                    <Button
                        Content="Perplexity"
                        Width="100"
                        Height="36"
                        Click="Perplexity_Click"/>

                </StackPanel>

            </Border>


            <!-- WEBVIEW -->
            <Border
                Grid.Row="2"
                Margin="10"
                Background="#0D1720">

                <wv2:WebView2
                    x:Name="Browser"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>

            </Border>

        </Grid>

    </Border>

</Window>